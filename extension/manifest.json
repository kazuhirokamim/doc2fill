{
  "manifest_version": 3,
  "name": "doc2fill — Autofill Inteligente",
  "version": "0.1.1",
  "description": "Preenchimento inteligente de notas e certidões em portais governamentais com Zero Retenção de Dados.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir doc2fill"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidepanel.html", "sidepanel.css", "sidepanel.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
